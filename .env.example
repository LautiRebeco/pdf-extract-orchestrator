# Puertos expuestos por Traefik
GATEWAY_PORT=8000
TRAEFIK_DASHBOARD_PORT=8080

# Imágenes Docker de cada repositorio (cambiar a tag vX.Y.Z o sha-... en producción)
EXTRACT_IMAGE=ghcr.io/lighuen04/pdf-extract-service:latest
DOCUMENTS_IMAGE=ghcr.io/lautirebeco/pdf-documents-service:latest

# Escalado y límites
EXTRACT_REPLICAS=5
MAX_PDF_SIZE_BYTES=10485760
APP_OCR_ENABLED=false
APP_EXTRACT_WORKERS=1
APP_MAX_PENDING_EXTRACTIONS=100

# Base de datos y resiliencia
MONGODB_DB_NAME=pdf-extractext
MONGO_COLLECTION_NAME=documents
EXTRACT_TIMEOUT_S=30
EXTRACT_MAX_ATTEMPTS=2
DOCUMENTS_API_KEY=

# Rate Limit en Traefik (peticiones por segundo por IP)
RATE_LIMIT_AVG=30
RATE_LIMIT_BURST=60
